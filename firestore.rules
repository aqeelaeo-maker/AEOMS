rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_-]+$');
    }

    // Role check: AEO Admin has access to all records in the jurisdiction
    function isAEOAdmin() {
      return isSignedIn() && (
        ('email' in request.auth.token && request.auth.token.email == 'dydeowpindigheb@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         'role' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'aeo_admin')
      );
    }

    // School user can only access and update their own assigned school EMIS records, or AEO admin
    function isSchoolAuthorized(schoolId) {
      return isSignedIn() && (
        isAEOAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         'schoolEmisCode' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolEmisCode == schoolId)
      );
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Schools collection (Add, Edit, Delete for AEO admin / authorized schools)
    match /schools/{schoolId} {
      allow read: if true;
      allow create, update, delete: if isValidId(schoolId);
    }

    // User accounts
    match /users/{userId} {
      allow read: if true;
      allow create, update: if isValidId(userId);
      allow delete: if isValidId(userId);
    }

    // Enrollment records (submitted by each school, viewable by AEO)
    match /enrollment/{schoolId} {
      allow read: if true;
      allow write: if isValidId(schoolId);
    }

    // NSB budget & expenditure records
    match /nsb/{schoolId} {
      allow read: if true;
      allow write: if isValidId(schoolId);
    }

    // FTF student fund records
    match /ftf/{schoolId} {
      allow read: if true;
      allow write: if isValidId(schoolId);
    }

    // Building and facilities
    match /facilities/{schoolId} {
      allow read: if true;
      allow write: if isValidId(schoolId);
    }

    // Teaching & non-teaching staff records
    match /staff/{schoolId} {
      allow read: if true;
      allow write: if isValidId(schoolId);
    }

    // Evidence, bills, and document uploads
    match /documents/{docId} {
      allow read: if true;
      allow create, update, delete: if isValidId(docId);
    }

    // Data submissions and approval workflow
    match /submissions/{submissionId} {
      allow read: if true;
      allow create, update: if isValidId(submissionId);
      allow delete: if isValidId(submissionId);
    }

    // Tamper-evident audit logs
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if isValidId(logId);
      allow update, delete: if false; // Append-only audit log
    }
  }
}
