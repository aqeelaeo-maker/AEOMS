rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Role check: AEO Admin has access to all records in the jurisdiction
    function isAEOAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'dydeowpindigheb@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'aeo_admin')
      );
    }

    // School user can only access and update their own assigned school EMIS records
    function isSchoolAuthorized(schoolId) {
      return isSignedIn() && (
        isAEOAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.schoolEmisCode == schoolId)
      );
    }

    // Schools collection
    match /schools/{schoolId} {
      allow read: if isSignedIn();
      allow create, delete: if isAEOAdmin();
      allow update: if isAEOAdmin() || (isSchoolAuthorized(schoolId) && isValidId(schoolId));
    }

    // User accounts
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAEOAdmin());
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (request.auth.uid == userId || isAEOAdmin());
      allow delete: if isAEOAdmin();
    }

    // Enrollment records
    match /enrollment/{schoolId} {
      allow read: if isSignedIn();
      allow write: if isSchoolAuthorized(schoolId) && isValidId(schoolId);
    }

    // NSB budget & expenditure records
    match /nsb/{schoolId} {
      allow read: if isSignedIn();
      allow write: if isSchoolAuthorized(schoolId) && isValidId(schoolId);
    }

    // FTF student fund records
    match /ftf/{schoolId} {
      allow read: if isSignedIn();
      allow write: if isSchoolAuthorized(schoolId) && isValidId(schoolId);
    }

    // Building and facilities
    match /facilities/{schoolId} {
      allow read: if isSignedIn();
      allow write: if isSchoolAuthorized(schoolId) && isValidId(schoolId);
    }

    // Teaching & non-teaching staff records
    match /staff/{schoolId} {
      allow read: if isSignedIn();
      allow write: if isSchoolAuthorized(schoolId) && isValidId(schoolId);
    }

    // Data submissions and approval workflow
    match /submissions/{submissionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(submissionId);
      allow update: if isSignedIn() && isValidId(submissionId);
      allow delete: if isAEOAdmin();
    }

    // Tamper-evident audit logs
    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(logId);
      allow update, delete: if false; // Append-only audit log
    }
  }
}
